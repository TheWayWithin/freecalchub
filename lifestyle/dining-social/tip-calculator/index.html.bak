            { "@type": "Question", "name": "What is a standard tip percentage for a restaurant?", "acceptedAnswer": { "@type": "Answer", "text": "In the United States, a standard tip for good service at a restaurant is typically between 15% and 20% of the pre-tax bill. Some people choose to tip more for excellent service." } },
            { "@type": "Question", "name": "Should I tip on the pre-tax or post-tax amount of the bill?", "acceptedAnswer": { "@type": "Answer", "text": "It is customary to calculate the tip based on the pre-tax amount of the bill. However, some people prefer to tip on the total amount for simplicity." } },
            { "@type": "Question", "name": "How much should I tip for delivery services?", "acceptedAnswer": { "@type": "Answer", "text": "For food delivery, a tip of 15-20% is common, similar to restaurant dining. For grocery delivery, 10-15% or a flat amount might be appropriate depending on the size and difficulty of the order." } },
            { "@type": "Question", "name": "Is it okay not to tip if the service was bad?", "acceptedAnswer": { "@type": "Answer", "text": "Tipping is generally a reflection of service quality. If service was exceptionally poor, some people choose to tip a lower percentage or speak to management. However, in many service industries, workers rely on tips for a significant portion of their income." } },
            { "@type": "Question", "name": "How does this tip calculator handle splitting the bill?", "acceptedAnswer": { "@type": "Answer", "text": "Our calculator divides the total bill (including the calculated tip) evenly by the number of people you specify. It ensures everyone pays an equal share of both the main bill and the gratuity." } },
