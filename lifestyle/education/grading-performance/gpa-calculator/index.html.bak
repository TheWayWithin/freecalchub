            { "@type": "Question", "name": "What is the difference between semester GPA and cumulative GPA?", "acceptedAnswer": { "@type": "Answer", "text": "Semester GPA is your grade point average for a single semester's courses. Cumulative GPA is your overall grade point average for all courses taken across all semesters up to a certain point." } },
            { "@type": "Question", "name": "Does this calculator work for high school and college GPA?", "acceptedAnswer": { "@type": "Answer", "text": "Yes, this calculator can be used for both high school and college GPA, as long as your school uses a standard grading scale (like the 4.0 scale) and assigns credit hours to courses." } },
