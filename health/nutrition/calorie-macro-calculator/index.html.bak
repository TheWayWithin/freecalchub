            <article class="calculator-page-content"> 
                <h1 class="page-title">Comprehensive Calorie & Macro Calculator</h1>

                <section class="calculator-description-section content-section">
                    <p>Briefly introduce the common struggle of calculating caloric and macro needs. Emphasize the calculator's unique transparent approach, allowing users to choose BMR formulas (Mifflin-St Jeor, Harris-Benedict) and understand the science behind their personalized results for weight loss, gain, or maintenance. Position it as more than just a calculator, but an educational tool.</p>
                </section>

                <section id="calculator-section" class="calculator-interface content-section card"> 
                    <h2 class="section-title">Calculate Your Daily Needs</h2>
                    <div id="errorMessages" class="error-messages" style="display:none;"></div>
                    <form id="calculatorForm" class="calculator-form">
                        <fieldset>
                            <legend>Personal Details</legend>
                            <div class="form-group">
                                <label for="unit_preference">Unit Preference:</label>
                                <div class="radio-group">
                                    <input type="radio" id="imperial_units" name="unit_preference" value="imperial" checked>
                                    <label for="imperial_units">Imperial (ft/in, lbs)</label>
                                    <input type="radio" id="metric_units" name="unit_preference" value="metric">
                                    <label for="metric_units">Metric (cm, kg)</label>
                                </div>
                                <p class="help-text">Select your preferred unit system for height and weight.</p>
                            </div>

                            <div class="form-group">
                                <label>Gender:</label>
                                <div class="radio-group">
                                    <input type="radio" id="gender_male" name="gender" value="male" required>
                                    <label for="gender_male">Male</label>
                                    <input type="radio" id="gender_female" name="gender" value="female">
                                    <label for="gender_female">Female</label>
                                </div>
                                <p class="help-text">Select your biological sex.</p>
                            </div>

                            <div class="form-group">
                                <label for="age">Age (years):</label>
                                <input type="number" id="age" placeholder="e.g., 30" required min="1" max="120">
                                <p class="help-text">Enter your age in years.</p>
                            </div>

                            <div class="form-group" id="height_imperial_group">
                                <label for="height_ft">Height (Imperial):</label>
                                <div class="input-group">
                                    <input type="number" id="height_ft" placeholder="e.g., 5" min="3" max="7">
                                    <span class="unit">ft</span>
                                    <input type="number" id="height_in" placeholder="e.g., 10" min="0" max="11">
                                    <span class="unit">in</span>
                                </div>
                                <p class="help-text">Your height in feet and inches.</p>
                            </div>
                            <div class="form-group" id="height_metric_group" style="display:none;">
                                <label for="height_cm">Height (Metric):</label>
                                <div class="input-group">
                                    <input type="number" id="height_cm" placeholder="e.g., 178" min="90" max="250">
                                    <span class="unit">cm</span>
                                </div>
                                <p class="help-text">Your height in centimeters.</p>
                            </div>

                            <div class="form-group" id="weight_imperial_group">
                                <label for="weight_lbs">Weight (Imperial):</label>
                                <div class="input-group">
                                    <input type="number" id="weight_lbs" placeholder="e.g., 150" min="50" max="700">
                                    <span class="unit">lbs</span>
                                </div>
                                <p class="help-text">Your weight in pounds.</p>
                            </div>
                            <div class="form-group" id="weight_metric_group" style="display:none;">
                                <label for="weight_kg">Weight (Metric):</label>
                                <div class="input-group">
                                    <input type="number" id="weight_kg" placeholder="e.g., 68" min="20" max="350">
                                    <span class="unit">kg</span>
                                </div>
                                <p class="help-text">Your weight in kilograms.</p>
                            </div>

                            <div class="form-group">
                                <label for="activity_level">Activity Level:</label>
                                <select id="activity_level" required>
                                    <option value="">Select Activity Level</option>
                                    <option value="sedentary">Sedentary (little or no exercise)</option>
                                    <option value="lightly_active">Lightly Active (light exercise/sports 1-3 days/week)</option>
                                    <option value="moderately_active">Moderately Active (moderate exercise/sports 3-5 days/week)</option>
                                    <option value="very_active">Very Active (hard exercise/sports 6-7 days/week)</option>
                                    <option value="extremely_active">Extremely Active (very hard exercise/physical job)</option>
                                </select>
                                <p class="help-text">Defines your daily physical activity.</p>
                            </div>

                            <div class="form-group">
                                <label>BMR Formula:</label>
                                <div class="radio-group">
                                    <input type="radio" id="mifflin_st_jeor" name="bmr_formula" value="mifflin_st_jeor" checked>
                                    <label for="mifflin_st_jeor">Mifflin-St Jeor (Generally More Accurate)</label>
                                    <input type="radio" id="harris_benedict" name="bmr_formula" value="harris_benedict">
                                    <label for="harris_benedict">Revised Harris-Benedict</label>
                                </div>
                                <p class="help-text">Choose the formula for your Basal Metabolic Rate calculation. Mifflin-St Jeor is generally more accurate.</p>
                            </div>

                             <div class="form-group">
                                <label>Goal:</label>
                                <div class="radio-group">
                                    <input type="radio" id="goal_maintenance" name="goal" value="maintenance" checked>
                                    <label for="goal_maintenance">Weight Maintenance</label>
                                    <input type="radio" id="goal_weight_loss" name="goal" value="weight_loss">
                                    <label for="goal_weight_loss">Weight Loss</label>
                                    <input type="radio" id="goal_muscle_gain" name="goal" value="muscle_gain">
                                    <label for="goal_muscle_gain">Muscle Gain</label>
                                </div>
                                <p class="help-text">Your primary objective (weight loss, maintenance, or muscle gain).</p>
                            </div>
                        </fieldset>
                        <div class="form-actions">
                            <button type="button" id="calculateButton" class="btn btn-primary">Calculate</button>
                            <button type="reset" id="resetButton" class="btn btn-secondary">Reset</button>
                        </div>
                    </form>

                    <div id="resultsSection" class="results-section" style="display:none;">
                        <h3 class="results-title">Your Estimated Daily Needs</h3>
                        <div class="results-grid">
                            <div class="result-item card"> 
                                <h4>Basal Metabolic Rate (BMR)</h4>
                                <p id="result_bmr">--</p>
                            </div>
                            <div class="result-item card"> 
                                <h4>Total Daily Energy Expenditure (TDEE)</h4>
                                <p id="result_tdee">--</p>
                            </div>
                            <div class="result-item card"> 
                                <h4>Target Daily Calories</h4>
                                <p id="result_target_calories">--</p>
                            </div>
                        </div>

                        <h3 class="results-title mt-4">Macronutrient Breakdown</h3>
                        <div class="results-grid">
                            <div class="result-item card"> 
                                <h4>Protein (grams)</h4>
                                <p id="result_protein_g">--</p>
                            </div>
                            <div class="result-item card"> 
                                <h4>Protein (calories)</h4>
                                <p id="result_protein_cal">--</p>
                            </div>
                            <div class="result-item card"> 
                                <h4>Carbohydrates (grams)</h4>
                                <p id="result_carbs_g">--</p>
                            </div>
                             <div class="result-item card"> 
                                <h4>Carbohydrates (calories)</h4>
                                <p id="result_carbs_cal">--</p>
                            </div>
                            <div class="result-item card"> 
                                <h4>Fats (grams)</h4>
                                <p id="result_fats_g">--</p>
                            </div>
                            <div class="result-item card"> 
                                <h4>Fats (calories)</h4>
                                <p id="result_fats_cal">--</p>
                            </div>
                        </div>
                    </div>
                </section>

